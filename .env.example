ANTHROPIC_API_KEY=
SIGNAL_SCREENER_DB_PATH=data/signal_screener.db
# SEC requires a descriptive User-Agent identifying you on every request.
SEC_USER_AGENT=your-name your-email@example.com

# Optional but recommended: fallback ticker match for non-US/EMA companies
# not in SEC's filer list. Free key: https://www.openfigi.com/user/signup
# (works without a key too, just at a lower rate limit).
OPENFIGI_API_KEY=

# Required for Tier 2 South Korean companies (filings/korea.py — DART's
# executive-status and major-shareholding APIs). Free key:
# https://opendart.fss.or.kr (no unauthenticated fallback, unlike OpenFIGI).
OPENDART_API_KEY=

# Weekly digest email (SMTP). For Gmail: smtp.gmail.com, port 587, and an
# App Password (not your normal password) — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=
